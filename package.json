{
  "name": "@deepseek-ai/dsh-workflow-engine",
  "version": "0.0.22",
  "description": "Declarative multi-agent workflow engine: flow spec + agent config, checkpoint/pause-resume, per-agent memory, materialization",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "^0.2.0 || ^0.2.1-rc.2"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:dsh": "node scripts/typecheck-dsh.mjs",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run tests src/engine/__tests__",
    "check": "npm run typecheck && npm run typecheck:dsh && npm test && npm run build",
    "prepack": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0 || ^0.2.1-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": { "optional": true },
    "@deepseek-ai/dsh-llm": { "optional": true },
    "@deepseek-ai/dsh-session": { "optional": true },
    "@deepseek-ai/dsh-skill-filesystem": { "optional": true },
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "examples"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "^0.2.0 || ^0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.0 || ^0.2.1-rc.2",
    "@types/node": "^22.20.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
